# Krishi AI - Expo Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Gemini API Key (get from https://aistudio.google.com)
# Free tier available — used as primary model (Gemini 2.0 Flash)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional but recommended: OpenRouter API Key (https://openrouter.ai)
# Enables FREE fallback models: Gemini 1.5 Flash, Llama 3.1 8B, Mistral 7B
# Free tier available at openrouter.ai — no credit card needed for free models
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Supabase (for user profiles & saved reports)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Hybrid Model Cascade ---
# The app automatically tries models in this order:
#   1. Gemini 2.0 Flash (GEMINI_API_KEY) — premium vision
#   2. Gemini 1.5 Flash via OpenRouter (OPENROUTER_API_KEY) — free vision
#   3. Llama 3.1 8B via OpenRouter (OPENROUTER_API_KEY) — free text
#   4. Rule-Based Expert System — offline, no API needed
