{
  "expo": {
    "name": "Krishi AI",
    "slug": "krishi-ai",
    "owner": "moniruzjaman",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "krishiai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A8A1F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.krishiai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ফসলের রোগ শনাক্ত করতে ক্যামেরা ব্যবহার করা হয়।",
        "NSLocationWhenInUseUsageDescription": "আপনার এলাকার আবহাওয়া ও কৃষি তথ্য দেখাতে লোকেশন ব্যবহার করা হয়।",
        "NSMicrophoneUsageDescription": "ভয়েস সার্চ ও AI কথোপকথনের জন্য মাইক্রোফোন ব্যবহার করা হয়।"
      }
    },
    "android": {
      "package": "com.krishiai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A8A1F"
      },
      "versionCode": 5,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ফসলের রোগ শনাক্ত করতে ক্যামেরা ব্যবহার করা হয়।"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "আপনার এলাকার আবহাওয়া ও কৃষি তথ্য দেখাতে লোকেশন ব্যবহার করা হয়।"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fc268b55-a3b2-4c1b-8b7b-f5ee611e86fb"
      }
    }
  }
}